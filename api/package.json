{
  "name": "pfdr-explorer-api",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-test-fixtures": "TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm tests/fixtures/generate-test-fixtures.ts",
    "docker-build-image": "docker build -t pfdr-explorer-api .",
    "docker-run": "docker run -e PORT=3000 -p 3000:3000 pfdr-explorer-api"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
